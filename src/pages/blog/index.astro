---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Layout title="Blog | Catonsville Garage Doors" description="Tips, maintenance advice, and guides for garage door care in Catonsville and Arbutus, MD.">
  <section class="hero" style="padding: 3rem 0 2rem;">
    <div class="container">
      <h1>Garage Door Blog</h1>
      <p class="hero-sub" style="margin-top: 0.75rem;">Maintenance tips, repair guides, and local advice for Catonsville homeowners.</p>
    </div>
  </section>
  <section class="section">
    <div class="container" style="max-width: 800px;">
      <div style="display: grid; gap: 1.5rem;">
        {posts.map((post) => (
          <article style="background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.5rem;">
            <h2 style="font-size: 1.25rem; margin-bottom: 0.5rem;">
              <a href={`/blog/${post.id}/`} style="color: var(--primary);">{post.data.title}</a>
            </h2>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 0.5rem;">
              {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
            <p style="color: var(--text-muted);">{post.data.description}</p>
            <a href={`/blog/${post.id}/`} style="display: inline-block; margin-top: 0.75rem; color: var(--primary); font-weight: 600;">Read more →</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
